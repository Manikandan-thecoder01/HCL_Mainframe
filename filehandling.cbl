IDENTIFICATION DIVISION.
PROGRAM-ID. LEDGER100.

ENVIRONMENT DIVISION.
INPUT-OUTPUT SECTION.

FILE-CONTROL.

    SELECT LEDGER-FILE
        ASSIGN TO LEDGERDD
        ORGANIZATION IS INDEXED
        ACCESS MODE IS DYNAMIC
        RECORD KEY IS LEDGER-KEY
        FILE STATUS IS WS-FILE-STATUS.

DATA DIVISION.
FILE SECTION.

FD LEDGER-FILE.

01 LEDGER-RECORD.
   05 LEDGER-KEY       PIC X(10).
   05 LEDGER-NAME      PIC X(30).
   05 LEDGER-BALANCE   PIC 9(7)V99.

WORKING-STORAGE SECTION.

01 WS-LEDGER.
   05 WS-KEY           PIC X(10).
   05 WS-NAME          PIC X(30).
   05 WS-BALANCE       PIC 9(7)V99.

01 WS-SEARCH-KEY       PIC X(10)
                       VALUE 'ACC-500000'.

01 WS-FILE-STATUS      PIC XX.

01 WS-COUNT            PIC 9(3) VALUE ZERO.

01 WS-START-STATUS     PIC X VALUE 'N'.

PROCEDURE DIVISION.

MAIN-PARA.

    OPEN INPUT LEDGER-FILE

    IF WS-FILE-STATUS NOT = '00'
        DISPLAY 'FILE OPEN ERROR: '
                WS-FILE-STATUS
        STOP RUN
    END-IF

    DISPLAY 'FILE OPENED SUCCESSFULLY'

    MOVE WS-SEARCH-KEY TO LEDGER-KEY

    START LEDGER-FILE
        KEY IS GREATER THAN OR EQUAL TO LEDGER-KEY
        INVALID KEY
            CONTINUE
    END-START

    IF WS-FILE-STATUS = '00'

        MOVE 'Y' TO WS-START-STATUS

        DISPLAY 'START SUCCESSFUL'

        PERFORM 100 TIMES

            READ LEDGER-FILE NEXT RECORD
                INTO WS-LEDGER

                AT END
                    DISPLAY 'END OF FILE REACHED'
                    EXIT PERFORM

            END-READ

            IF WS-FILE-STATUS NOT = '00'
                DISPLAY 'READ ERROR: '
                        WS-FILE-STATUS
                EXIT PERFORM
            END-IF

            ADD 1 TO WS-COUNT

            PERFORM EXTRACT-ENTRY

        END-PERFORM

    ELSE

        DISPLAY 'START FAILED. STATUS: '
                WS-FILE-STATUS

    END-IF

    DISPLAY '----------------------------'
    DISPLAY 'TOTAL RECORDS READ: ' WS-COUNT

    CLOSE LEDGER-FILE

    STOP RUN.


EXTRACT-ENTRY.

    DISPLAY '----------------------------'

    DISPLAY 'RECORD NUMBER: ' WS-COUNT

    DISPLAY 'ACCOUNT NUMBER: ' WS-KEY

    DISPLAY 'CUSTOMER NAME: ' WS-NAME

    DISPLAY 'ACCOUNT BALANCE: ' WS-BALANCE.
